<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>ru.solomentsev</groupId>
        <artifactId>atlassian-mcp-server</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>atlassian-mcp-app</artifactId>
    <name>atlassian-mcp-app</name>
    <description>Точка входа и сборка MCP-сервера Atlassian.</description>
    <dependencies>
        <dependency><groupId>ru.solomentsev</groupId><artifactId>atlassian-core</artifactId></dependency>
        <dependency><groupId>ru.solomentsev</groupId><artifactId>atlassian-jira</artifactId></dependency>
        <dependency><groupId>ru.solomentsev</groupId><artifactId>atlassian-confluence</artifactId></dependency>
        <dependency><groupId>junit</groupId><artifactId>junit</artifactId><scope>test</scope></dependency>
    </dependencies>
    <build>
        <finalName>atlassian-mcp-server-${project.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase><goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter><artifact>*:*</artifact><excludes>
                                    <exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude>
                                </excludes></filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>ru.solomentsev.app.AtlassianMcpServer</mainClass>
                                    <manifestEntries>
                                        <Main-Class>ru.solomentsev.app.AtlassianMcpServer</Main-Class>
                                        <Implementation-Title>${project.name}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
